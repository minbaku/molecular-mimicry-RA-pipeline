# ── pLDDT Sensitivity Analysis ────────────────────────
# FIX: Uses MEAN pLDDT per entry, not MIN.
# MIN was over-conservative: one low-confidence region in any human match
# penalised the entire entry. MEAN is representative of overall confidence.

import pandas as pd
from scipy.stats import pearsonr

df_plddt_raw = pd.read_excel('/content/pLDDT_Neuro.xlsx') # ← change to 'pLDDT_Rheuma' for the Rheumatic dataset

plddt_agg = df_plddt_raw.groupby(['Organism', 'Protein', 'Position']).agg(
    mean_pLDDT_min =('mean_pLDDT', 'min'),
    mean_pLDDT_mean=('mean_pLDDT', 'mean'),
    n_regions      =('mean_pLDDT', 'count')
).reset_index()

print(f"pLDDT file shape: {df_plddt_raw.shape}")
