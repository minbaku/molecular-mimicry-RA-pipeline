def fisher_z_test(r1, n1, r2, n2):
    """
    Fisher z-transformation test comparing two Pearson or Spearman
    correlation coefficients from independent samples.

    Parameters:
        r1, r2: correlation coefficients
        n1, n2: sample sizes

    Returns:
        z_stat: test statistic
        p_value: two-tailed p-value
    """
    # Handle edge cases
    r1 = np.clip(r1, -0.9999, 0.9999)
    r2 = np.clip(r2, -0.9999, 0.9999)

    z1 = np.arctanh(r1)
    z2 = np.arctanh(r2)
    se = np.sqrt(1/(n1 - 3) + 1/(n2 - 3))
    z_stat = (z1 - z2) / se
    p_value = 2 * (1 - norm.cdf(abs(z_stat)))
    return z_stat, p_value

